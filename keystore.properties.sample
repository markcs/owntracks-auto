# Copy this file to keystore.properties and fill in your release keystore details.
# keystore.properties is gitignored and must never be committed.
#
# Create a keystore once with:
#   keytool -genkey -v -keystore release.jks -keyalg RSA -keysize 2048 \
#           -validity 10000 -alias owntracks
#
# storeFile may be an absolute path or relative to the project root.

storeFile=release.jks
storePassword=CHANGE_ME
keyAlias=owntracks
keyPassword=CHANGE_ME
